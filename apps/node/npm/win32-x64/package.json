{
  "name": "@shotkit/win32-x64",
  "version": "0.2.0",
  "description": "ShotKit native Node addon for Windows x64",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj817/shotkit.git"
  },
  "license": "UNLICENSED",
  "preferUnplugged": true,
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "shot.node",
    "*.dll"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "prepublishOnly": "node -e \"require('node:fs').accessSync('shot.node')\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
